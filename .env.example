# 이 파일을 .env 로 복사해서 값을 채우세요. (.env는 커밋하지 마세요)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# function calling 사용 시 reasoning 모델은 none 필요. 비우면 파라미터를 보내지 않음
OPENAI_REASONING_EFFORT=none
DB_PASSWORD=mycar

# 로그인 세션 토큰 서명 키 (32자 이상 무작위 문자열). 예: openssl rand -base64 48
JWT_SECRET=

# 채팅 분당 최대 메시지 수(로그인 사용자는 계정, 게스트는 IP 기준)
CHAT_LIMIT_PER_MINUTE=6
# 하루(한국 시간 0시 초기화) 채팅 메시지 수
CHAT_DAILY_USER=60
CHAT_DAILY_GUEST=20

# 근처 정비소(구글 지도) 브라우저용 키. Google Cloud에서 HTTP 리퍼러(도메인) 제한 + Maps JavaScript API, Places API (New)만 허용할 것
GOOGLE_MAPS_API_KEY=
